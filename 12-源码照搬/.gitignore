# 依赖
node_modules/
.DS_Store
*.7z
*.zip
_临时/
发布/

# 包管理器 / Electron 下载缓存（本机产物，体积大且与平台相关，绝不入库）
.npm-cache/
.npm/
.electron-cache/
*.tgz

# 引擎数据（用户自己的，不入库）
引擎数据/.dsh/sessions/
引擎数据/.dsh/storages/
引擎数据/.dsh/llm-*/
引擎数据/.dsh/profiles/web/*
# headless 是引擎按需从内置模板落盘出来的运行时骨架（恢复自 2026-11-01 清理），不入库
引擎数据/.dsh/profiles/headless/
!引擎数据/.dsh/profiles/web/cordis.yml
# cordis.patch.yml 不跟踪：引擎运行时会写本机状态（公告已读之类）
!引擎数据/.dsh/profiles/web/package.json
!引擎数据/.dsh/profiles/web/pnpm-workspace.yaml
引擎数据/.dsh/.credentials.yaml
引擎数据/.dsh/.anonymous-user-id

# 本机实例清单（含真实会话 id / 本机路径，绝不出包）
工作台.json

# 工作台运行时
外壳/data/electron-profile/
外壳/data/crash-state.json
外壳/data/start-guard.json
外壳/data/updater-state.json
外壳/data/version-policy-state.json
外壳/data/windows.json
外壳/data/sidebar-state.json
外壳/data/boot-preview.json
外壳/server.log
外壳/server.err.log
# 轮转产物：main.js 的 rotateLog() 把超过 4MB 的 server.log 改名为 server.log.prev
# （根 .gitignore 的 *.log 匹配不到 .log.prev，所以这里必须单独挡一次）
外壳/server.log.*
外壳/captures/

# 记忆内部层（保留骨架，不提交个人内容）
引擎数据/.dsh/场景记忆/*/归档/*.md

# 体检卡数据与报告：工具生成的本机结果（覆盖写），不入库
引擎数据/.dsh/场景记忆/_体检-latest.json
引擎数据/.dsh/场景记忆/说明/

# 场景插件运行时写的本机状态（B站"当前视频"、点击探针）：跑一次就变，不入库
引擎数据/.dsh/场景记忆/*/当前视频.json
引擎数据/.dsh/场景记忆/*/_点击探针.json